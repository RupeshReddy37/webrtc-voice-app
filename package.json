{
  "name": "arv",
  "version": "2.0.0",
  "description": "ARV - Audio or Video. Modern full-screen React + Vite WebRTC app for 1-on-1 voice, video, and text chat.",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k -n server,vite -c blue,magenta \"node server.js\" \"vite\"",
    "build": "vite build",
    "start": "npm run build && node server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^4.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
